{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "model": "morph/morph-kimik3",
  "subagent_depth": 2,
  "agent": {
    "kimi-lane": {
      "description": "Independent investigation lane; delegates concrete probes only to DeepSeek workers.",
      "mode": "subagent",
      "model": "morph/morph-kimik3",
      "permission": { "task": { "deepseek-worker": "allow" } }
    },
    "deepseek-worker": {
      "description": "Bounded leaf worker for one concrete task; cannot delegate further.",
      "mode": "subagent",
      "model": "morph-abliterated/morph-dsv41flash-abliterated",
      "permission": { "task": "deny" }
    }
  },
  "provider": {
    "morph": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Morph",
      "options": {
        "baseURL": "https://api.morphllm.com/v1",
        "apiKey": "{env:MORPH_API_KEY}"
      },
      "models": {
        "morph-kimik3": {
          "name": "Kimi K3",
          "reasoning": true,
          "tool_call": true,
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    },
    "morph-abliterated": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Morph Abliterated",
      "options": {
        "baseURL": "https://api.morphllm.com/v1",
        "apiKey": "{env:MORPH_API_KEY}"
      },
      "models": {
        "morph-dsv41flash-abliterated": {
          "name": "DeepSeek V4.1 Flash Abliterated",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1048576, "output": 32768 }
        },
        "morph-kimik3-abliterated": {
          "name": "Kimi K3.1 Pro Abliterated",
          "reasoning": true,
          "tool_call": true,
          "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 1048576, "output": 32768 }
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "write": "allow",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "external_directory": "allow",
    "doom_loop": "allow",
    "question": "deny",
    "plan_enter": "deny"
  }
}
