# Copy to .env (git-ignored) and fill in. fleet.py and fly/attach.sh load it.

# Fleet backend: local (default — parallel subagents on this machine, zero
# extra setup), boat (sandbox fleet; `boat login` is all that's needed), or
# fly (private-network fleet; see README).
FLEET_BACKEND=local

# boat backend knobs (defaults shown).
BOAT_TYPE=small
BOAT_TTL=14400

# fly backend (coordinator server + optional fly worker fleet): Machines API
# token (fly tokens create), the app that owns the machines, default region.
FLY_API_TOKEN=
FLY_APP=
FLY_REGION=iad

# Basic-auth password for every opencode serve instance (coordinator + workers).
# Keep it strong; it guards HTTP access to agents with tool permissions.
OPENCODE_SERVER_PASSWORD=

# Morph API key — injected into boxes on `fleet up`, used by fly/opencode.json
# for BOTH providers: the standard endpoint and the ablated worker endpoint
# (verified live: the same account key works on both).
MORPH_API_KEY=

# Optional: model overrides (defaults shown; coordinator/lanes on Kimi K3 Fast,
# workers on DeepSeek V4.1 Flash Abliterated).
# WORKER_MODEL=morph-abliterated/morph-dsv41flash-abliterated
# LANE_MODEL=morph/morph-kimik3-fast

# Optional: cloud browsers for JS-heavy recon (clis/browser.py).
# Injected into machines on `fleet up` when present.
# BROWSER_USE_API_KEY=
